<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --gold: #d8b66a;
  --gold-light: #f3d99b;
  --black: #080808;
  --panel: #121210;
  --muted: #aaa69b;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% 0%, #49371b 0%, transparent 42%),
    var(--black);
  color: #f5f1e8;
  font-family: 'Inter', sans-serif;
  padding: 25px 16px 40px;
}

.container {
  max-width: 650px;
  margin: auto;
}

/* HEADER */

.header {
  text-align: center;
  padding: 30px 10px 25px;
}

.logo {
  width: 76px;
  height: 76px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  display: grid;
  place-items: center;
  margin: 0 auto 18px;
  color: var(--gold-light);
  font: 700 29px 'Cinzel', serif;
  box-shadow: 0 0 35px #d8b66a22;
}

.eyebrow {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 5px;
  font-weight: 700;
}

.header h1 {
  font: 600 clamp(30px, 8vw, 43px) 'Cinzel', serif;
  letter-spacing: 3px;
  margin: 12px 0;
}

.header p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.line {
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--gold),
    transparent
  );
  margin: 10px 0 28px;
}

/* MAIN BUTTONS */

.main-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 35px;
}

.main-btn {
  min-height: 58px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  transition: .25s;
}

.main-btn:hover,
.order-btn:hover {
  transform: translateY(-3px);
}

.donate {
  background: linear-gradient(135deg, #f0d89c, #b88b3f);
  color: #17120a;
}

.whatsapp {
  background: #102018;
  border: 1px solid #4b8b62;
  color: #b9edc8;
}

/* PRICE LIST */

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.section-title h2 {
  font: 600 19px 'Cinzel', serif;
  letter-spacing: 1px;
}

.section-title span {
  color: var(--gold);
  font-size: 9px;
  letter-spacing: 2px;
}

.category {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  margin: 23px 3px 11px;
}

.package {
  background: linear-gradient(145deg, #191916, #0e0e0d);
  border: 1px solid #3a3324;
  border-radius: 14px;
  padding: 18px;
  margin-bottom: 11px;
  transition: .25s;
}

.package:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
}

.package-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.package-name {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .6px;
}

.price {
  color: var(--gold-light);
  font: 700 16px 'Cinzel', serif;
  white-space: nowrap;
}

.description {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
  margin: 10px 0 14px;
}

.order-btn {
  display: inline-block;
  padding: 10px 15px;
  background: var(--gold);
  color: #17120a;
  text-decoration: none;
  border-radius: 8px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  transition: .25s;
}

/* FOOTER */

.note {
  color: #888276;
  text-align: center;
  font-size: 10px;
  line-height: 1.8;
  margin: 27px 10px;
}

.footer {
  text-align: center;
  color: #625d52;
  font-size: 9px;
  letter-spacing: 3px;
  margin-top: 30px;
}

@media(max-width: 390px) {
  .main-buttons {
    grid-template-columns: 1fr;
  }

  .package-top {
    align-items: flex-start;
    flex-direction: column;
  }
}
</style>
</head>

